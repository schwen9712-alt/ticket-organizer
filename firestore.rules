rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 代理收件通道 ─────────────────────────────────────────────
    match /agent-orders/{id} {
      // 代理创建：必须匿名登录、只能以自己 uid 建、初始 pending、字段限长
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.raw is string
        && request.resource.data.raw.size() > 0
        && request.resource.data.raw.size() < 20000
        && request.resource.data.agent is string
        && request.resource.data.agent.size() > 0
        && request.resource.data.agent.size() < 40;
      // 代理只能看自己的
      allow get, list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      // 代理只能把自己的 pending 改成 cancelled，不许改内容
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
      // 管理员（uid 白名单在 admin/config.uids）全权读列与状态更新
      allow get, list, update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/admin/config).data.uids;
      allow delete: if false;
    }

    // ── 管理员白名单（只在 Firebase 控制台手工编辑）──────────────
    match /admin/config {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── 其余全部封死（旧 ticket-organizer 同步集合就此下线）──────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
